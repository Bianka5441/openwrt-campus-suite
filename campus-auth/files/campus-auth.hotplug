#!/bin/sh
# /etc/hotplug.d/iface/99-campus-auth - re-apply the protection mode
# whenever a network interface comes up.
#
# The hardening rules need the campus uplink to exist; the uplink often
# comes up long after boot/mode-switch (cable plugged in later, slow
# campus DHCP). netifd hotplug is the only reliable trigger - a bounded
# background retry goes stale, this does not.
#
# shellcheck disable=SC2034
[ "$ACTION" = ifup ] || exit 0
[ "$INTERFACE" = loopback ] && exit 0

[ -x /usr/bin/campus-auth-mode ] || exit 0
[ -e /etc/config/campus-auth ] || exit 0

# Wait for the campus DHCP lease: carrier-up is not route-up, and a
# single fixed-delay apply misses slow leases. Poll for the default
# route for up to two minutes, then apply once.
(
	sleep 5
	i=0
	while [ "$i" -lt 24 ]; do
		if ip -4 route show default >/dev/null 2>&1; then
			/usr/bin/campus-auth-mode apply >/dev/null 2>&1
			exit 0
		fi
		sleep 5
		i=$((i + 1))
	done
) &

#!/bin/sh /etc/rc.common
# procd service running the campus-auth connectivity monitor.

USE_PROCD=1
START=99
STOP=10

start_service() {
	local enabled auto_auth
	config_load campus-auth
	config_get_bool enabled config enabled 1
	[ "$enabled" = 1 ] || return 0

	# Bring the protection stack (UA3F / OpenClash / hardening) in line
	# with the mode selected in UCI before starting the auth loop.
	if [ -x /usr/bin/campus-auth-mode ]; then
		/usr/bin/campus-auth-mode apply
	fi

	# Mode "normal" IS a plain router: the protection stack is reverted
	# above and no authentication ever happens (manual LuCI button still
	# works). Only anti-detect/proxy run the auth loop.
	config_get mode config mode 'normal'
	[ "$mode" != "normal" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/campus-auth-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger campus-auth
}
